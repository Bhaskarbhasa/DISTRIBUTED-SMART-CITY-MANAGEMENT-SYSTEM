# ==========================================
# Distributed Smart City Management System
# Environment Variables - DEVELOPMENT ONLY
# DO NOT commit actual .env to source control
# ==========================================

# ------------------------------------------
# Database Config (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartcity
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/smartcity

# ------------------------------------------
# Redis Config
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# Kafka Config
# ------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# ------------------------------------------
# MQTT Config
# ------------------------------------------
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=smartcity
MQTT_PASSWORD=smartcity123

# ------------------------------------------
# InfluxDB Config
# ------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin12345
INFLUXDB_ORG=smartcity
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=my-super-secret-auth-token

# ------------------------------------------
# MinIO (S3-compatible Data Lake) Config
# ------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123

# ------------------------------------------
# Grafana Config
# ------------------------------------------
GRAFANA_PASSWORD=admin

# ------------------------------------------
# Authentication Config (CHANGE IN PRODUCTION!)
# ------------------------------------------
JWT_SECRET=super-secret-jwt-key-CHANGE-IN-PRODUCTION-use-256-bit-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------
# Service Ports (matches docker-compose.yml)
# ------------------------------------------
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
TRAFFIC_SERVICE_PORT=8002
EMERGENCY_SERVICE_PORT=8003
ENVIRONMENT_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
INGESTION_SERVICE_PORT=8007

# Internal service URLs (used by api-gateway)
AUTH_SERVICE_URL=http://auth-service:8001
TRAFFIC_SERVICE_URL=http://traffic-service:8002
EMERGENCY_SERVICE_URL=http://emergency-service:8003
ENVIRONMENT_SERVICE_URL=http://environment-service:8004
ANALYTICS_SERVICE_URL=http://analytics-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006
INGESTION_SERVICE_URL=http://ingestion-service:8007

# ------------------------------------------
# Fog Cluster Configuration (Raft Consensus)
# ------------------------------------------
FOG_NODE_1_HOST=fog-node-1
FOG_NODE_1_PORT=8020
FOG_NODE_2_HOST=fog-node-2
FOG_NODE_2_PORT=8022
FOG_NODE_3_HOST=fog-node-3
FOG_NODE_3_PORT=8024

# Used by traffic-service to call fog coordinator
FOG_COORDINATOR_URL=http://fog-node-1:8020

# Raft timing (milliseconds)
ELECTION_TIMEOUT_MIN_MS=150
ELECTION_TIMEOUT_MAX_MS=300
HEARTBEAT_INTERVAL_MS=50

# ------------------------------------------
# Traffic Control Thresholds
# ------------------------------------------
# vehicle_count thresholds
TRAFFIC_LOW_THRESHOLD=30
TRAFFIC_MEDIUM_THRESHOLD=70
TRAFFIC_HIGH_THRESHOLD=100

# Signal durations (seconds)
SIGNAL_LOW_GREEN=30
SIGNAL_LOW_YELLOW=5
SIGNAL_LOW_RED=25
SIGNAL_MEDIUM_GREEN=45
SIGNAL_MEDIUM_YELLOW=5
SIGNAL_MEDIUM_RED=20
SIGNAL_HIGH_GREEN=60
SIGNAL_HIGH_YELLOW=5
SIGNAL_HIGH_RED=15
SIGNAL_CRITICAL_GREEN=90
SIGNAL_CRITICAL_YELLOW=5
SIGNAL_CRITICAL_RED=10
SIGNAL_EMERGENCY_GREEN=120
SIGNAL_EMERGENCY_YELLOW=3
SIGNAL_EMERGENCY_RED=5

# ------------------------------------------
# Environment Monitoring Thresholds
# ------------------------------------------
AQI_MODERATE_THRESHOLD=100
AQI_UNHEALTHY_THRESHOLD=150
AQI_VERY_UNHEALTHY_THRESHOLD=200
AQI_HAZARDOUS_THRESHOLD=300
TEMPERATURE_HIGH_THRESHOLD=45
TEMPERATURE_LOW_THRESHOLD=-5
PM25_UNHEALTHY_THRESHOLD=35

# ------------------------------------------
# Simulator Configuration
# ------------------------------------------
# Events per second (default)
SIMULATOR_RATE=2
# Zones to simulate
SIMULATOR_ZONES=ZONE-A,ZONE-B,ZONE-C,ZONE-D,ZONE-E

# ------------------------------------------
# Edge Gateway Config
# ------------------------------------------
EDGE_GATEWAY_PORT=8008
EDGE_BUFFER_MAX_SIZE=10000
EDGE_BUFFER_RETRY_MAX=5

# ------------------------------------------
# Rate Limiting (requests per minute)
# ------------------------------------------
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_DEVICE=1000

# ------------------------------------------
# CORS Origins (comma-separated)
# ------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://frontend:80

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=INFO
